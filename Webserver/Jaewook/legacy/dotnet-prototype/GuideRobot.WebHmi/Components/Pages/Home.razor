@page "/"
@implements IDisposable
@using GuideRobot.WebHmi.Services
@inject RobotCommandService RobotCommand

<PageTitle>GuideRobot | 안내 로봇</PageTitle>

<div class="guide-page">
    <section class="hero-card">
        <div>
            <p class="eyebrow">GUIDEROBOT</p>
            <h1>@(HasArrived ? "목적지에 도착했습니다" : IsGuiding ? "로봇이 안내 중입니다" : "어디로 안내할까요?")</h1>
            <p class="hero-description">
                @(HasArrived
                    ? $"{SelectedDestination!.Name}에 안전하게 도착했어요."
                    : IsGuiding
                    ? $"{SelectedDestination!.Name}까지 안전하게 안내하고 있어요."
                    : "GuideRobot이 길을 안내해 드립니다.")
            </p>
        </div>
        <div class="robot-badge" aria-hidden="true">
            <img src="robot-mark.svg" alt="" />
        </div>
    </section>

    @if (IsGuiding)
    {
        <section class="journey-card" aria-live="polite">
            <div class="journey-heading">
                <div>
                    <p class="section-label">@(HasArrived ? "안내 완료" : "안내 진행 상황")</p>
                    <h2>@SelectedDestination!.Name</h2>
                </div>
                <strong class="guidance-state @(HasArrived ? "arrived" : "")">@(HasArrived ? "도착 완료" : "안내 중")</strong>
            </div>

            <div class="journey-message @(HasArrived ? "arrived" : "")">
                @if (!HasArrived)
                {
                    <span class="pulse-dot" aria-hidden="true"></span>
                }
                <p>@(HasArrived ? "목적지에 도착했습니다." : "안내 중입니다. 로봇을 따라와 주세요.")</p>
            </div>

            @if (HasArrived)
            {
                <button class="secondary-button arrival-confirm-button" disabled="@IsManualMode" @onclick="AcknowledgeArrival">
                    확인
                </button>
            }
            else
            {
                <button class="secondary-button" disabled="@(IsManualMode || IsControlSending)" @onclick="HandleSecondaryActionAsync">
                    @(IsControlSending ? "취소 요청 중..." : "안내 취소")
                </button>
            }

            @if (ControlError is not null)
            {
                <p class="command-result failure">@ControlError</p>
            }
        </section>
    }
    else
    {
        <section class="destination-section" aria-labelledby="destination-title">
            <div class="section-heading">
                <div>
                    <p class="section-label">목적지 선택</p>
                    <h2 id="destination-title">어디로 가시겠어요?</h2>
                </div>
                @if (SelectedDestination is not null)
                {
                    <span class="selected-destination">선택: @SelectedDestination.Name</span>
                }
            </div>

            <div class="destination-grid">
                @foreach (var destination in Destinations)
                {
                    <button class="destination-button @(SelectedDestination == destination ? "selected" : "")"
                            disabled="@IsManualMode"
                            aria-pressed="@(SelectedDestination == destination)"
                            @onclick="() => SelectDestination(destination)">
                        <span class="destination-pin" aria-hidden="true">@destination.Icon</span>
                        <span>@destination.Name</span>
                    </button>
                }
            </div>
        </section>

        <button class="start-button" disabled="@(IsManualMode || SelectedDestination is null || IsSendingCommand)" @onclick="OpenGuidanceConfirmation">
            <span aria-hidden="true">→</span>
            안내 시작
        </button>

        @if (CommandResult is not null)
        {
            <p class="command-result @(CommandResult.IsSuccess ? "success" : "failure")">@CommandResult.Message</p>
        }
    }
</div>

@if (IsGuidanceConfirmationOpen && SelectedDestination is not null)
{
    <div class="confirmation-backdrop" @onclick="CloseGuidanceConfirmation">
        <section class="confirmation-dialog" role="dialog" aria-modal="true" aria-labelledby="guidance-confirmation-title" @onclick:stopPropagation="true">
            <div class="confirmation-icon" aria-hidden="true">@SelectedDestination.Icon</div>
            <p class="section-label">안내 시작 확인</p>
            <h2 id="guidance-confirmation-title"><strong>@SelectedDestination.Name</strong><br />안내를 시작할까요?</h2>
            <div class="confirmation-actions">
                <button class="confirmation-cancel" disabled="@IsManualMode" @onclick="CloseGuidanceConfirmation">취소</button>
                <button class="confirmation-start" disabled="@(IsManualMode || IsSendingCommand)" @onclick="StartGuidanceAsync">
                    @(IsSendingCommand ? "서버에 전달 중..." : "안내 시작")
                </button>
            </div>
        </section>
    </div>
}

@if (IsManualMode)
{
    <div class="manual-control-overlay" role="dialog" aria-modal="true" aria-labelledby="manual-control-title" aria-describedby="manual-control-description">
        <section class="manual-control-dialog">
            <div class="manual-control-icon" aria-hidden="true">
                <img src="robot-mark.svg" alt="" />
            </div>
            <p class="section-label">MANUAL CONTROL</p>
            <h2 id="manual-control-title">관리자가 제어 중입니다</h2>
            <p id="manual-control-description">수동 제어가 끝날 때까지 잠시 기다려 주세요.</p>
            <div class="manual-control-status">
                <span class="pulse-dot" aria-hidden="true"></span>
                관리자 제어 연결됨
            </div>
        </section>
    </div>
}

@code {
    private readonly Destination[] Destinations =
    [
        new("restroom", "화장실 앞", "🚻"),
        new("room_301", "강의실 301호", "🏫"),
        new("room_302", "강의실 302호", "🏫"),
        new("elevator", "엘리베이터 앞", "🛗")
    ];
    private readonly CancellationTokenSource statusPollingCancellation = new();
    private PeriodicTimer? statusPollingTimer;

    private Destination? SelectedDestination { get; set; }
    private bool IsGuiding { get; set; }
    private bool IsSendingCommand { get; set; }
    private bool IsGuidanceConfirmationOpen { get; set; }
    private bool IsControlSending { get; set; }
    private bool IsManualMode { get; set; }
    private bool HasArrived { get; set; }
    private CommandResult? CommandResult { get; set; }
    private string? ControlError { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await RefreshStatusAsync(statusPollingCancellation.Token);
        _ = PollStatusAsync(statusPollingCancellation.Token);
    }

    private void SelectDestination(Destination destination)
    {
        if (!IsManualMode)
        {
            SelectedDestination = destination;
        }
    }

    private void OpenGuidanceConfirmation()
    {
        if (!IsManualMode && SelectedDestination is not null && !IsSendingCommand)
        {
            IsGuidanceConfirmationOpen = true;
        }
    }

    private void CloseGuidanceConfirmation()
    {
        if (!IsManualMode)
        {
            IsGuidanceConfirmationOpen = false;
        }
    }

    private async Task HandleSecondaryActionAsync()
    {
        if (IsManualMode || IsControlSending)
        {
            return;
        }

        await CancelGuidanceAsync();
    }

    private async Task StartGuidanceAsync()
    {
        if (IsManualMode || SelectedDestination is null)
        {
            return;
        }

        IsGuidanceConfirmationOpen = false;
        IsSendingCommand = true;
        CommandResult = await RobotCommand.SendDestinationAsync(SelectedDestination.Id);
        IsSendingCommand = false;

        if (!CommandResult.IsSuccess)
        {
            return;
        }

        IsGuiding = true;
        HasArrived = false;
        ControlError = null;
    }

    private async Task CancelGuidanceAsync()
    {
        if (IsManualMode || IsControlSending)
        {
            return;
        }

        IsControlSending = true;
        ControlError = null;
        var result = await RobotCommand.CancelGuidanceAsync();
        IsControlSending = false;

        if (!result.IsSuccess)
        {
            ControlError = result.Message;
            return;
        }

        ResetGuidanceUi();
    }

    private void ResetGuidanceUi()
    {
        IsGuiding = false;
        HasArrived = false;
        SelectedDestination = null;
        IsGuidanceConfirmationOpen = false;
        CommandResult = null;
        ControlError = null;
    }

    private void AcknowledgeArrival()
    {
        if (!IsManualMode)
        {
            ResetGuidanceUi();
        }
    }

    private async Task PollStatusAsync(CancellationToken cancellationToken)
    {
        statusPollingTimer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        try
        {
            while (await statusPollingTimer.WaitForNextTickAsync(cancellationToken))
            {
                await RefreshStatusAsync(cancellationToken);
            }
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
        }
    }

    private async Task RefreshStatusAsync(CancellationToken cancellationToken)
    {
        var status = await RobotCommand.GetStatusAsync(cancellationToken);

        if (!status.IsSuccess)
        {
            return;
        }

        var hasStateChanged = false;

        if (status.ManualMode != IsManualMode)
        {
            IsManualMode = status.ManualMode;
            hasStateChanged = true;

            if (IsManualMode)
            {
                IsGuidanceConfirmationOpen = false;
            }
        }

        if (IsGuiding
            && !HasArrived
            && string.Equals(status.NavigationStatus, "arrived", StringComparison.OrdinalIgnoreCase))
        {
            HasArrived = true;
            IsControlSending = false;
            ControlError = null;
            hasStateChanged = true;
        }

        if (hasStateChanged)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        statusPollingCancellation.Cancel();
        statusPollingTimer?.Dispose();
        statusPollingCancellation.Dispose();
    }

    private sealed record Destination(string Id, string Name, string Icon);
}
