<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="stm32_diffbot">
  <!-- Replace these measured dimensions before autonomous driving. -->
  <xacro:property name="body_length" value="0.32"/>
  <xacro:property name="body_width" value="0.28"/>
  <xacro:property name="body_height" value="0.10"/>
  <xacro:property name="body_mass" value="4.0"/>
  <xacro:property name="body_z" value="0.08"/>
  <xacro:property name="wheel_radius" value="0.065"/>
  <xacro:property name="wheel_width" value="0.030"/>
  <xacro:property name="wheel_separation" value="0.26"/>

  <material name="chassis_blue">
    <color rgba="0.10 0.25 0.65 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.03 0.03 0.03 1.0"/>
  </material>
  <material name="sensor_gray">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>

  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="chassis_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${body_mass}"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="${body_mass * (body_width * body_width + body_height * body_height) / 12.0}"
        ixy="0" ixz="0"
        iyy="${body_mass * (body_length * body_length + body_height * body_height) / 12.0}"
        iyz="0"
        izz="${body_mass * (body_length * body_length + body_width * body_width) / 12.0}"/>
    </inertial>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
    </link>
    <!-- Wheel rotation is measured on the STM32; these URDF joints only provide TF. -->
    <joint name="${side}_wheel_mount" type="fixed">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="0 ${y} ${wheel_radius - body_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel side="left" y="${wheel_separation / 2.0}"/>
  <xacro:wheel side="right" y="${-wheel_separation / 2.0}"/>

  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="0.038" length="0.040"/>
      </geometry>
      <material name="sensor_gray"/>
    </visual>
  </link>
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <!-- Measure XYZ and yaw of the actual LiDAR optical centre. -->
    <origin xyz="0.06 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="imu_link"/>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- REP-103: X forward, Y left, Z up. Adjust rpy for the PCB mounting. -->
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>
</robot>
