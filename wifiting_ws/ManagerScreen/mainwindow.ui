  <widget class="QWidget" name="centralwidget">
   <property name="styleSheet">
    <string notr="true">QWidget#centralwidget {
    background-color: #F3F6FA;
    color: #172033;
    font-family: &quot;Noto Sans CJK KR&quot;, &quot;Noto Sans KR&quot;, &quot;Sans Serif&quot;;
}

/* 헤더 */
QLabel#titleLabel {
    color: #172033;
    font-size: 27px;
    font-weight: 700;
}

QLabel#subtitleLabel {
    color: #778198;
    font-size: 13px;
}

QFrame#connectionBadge {
    background-color: #EAF8F0;
    border: 1px solid #BFE8CE;
    border-radius: 16px;
}

QLabel#connectionDot {
    background-color: #22A861;
    border-radius: 5px;
    min-width: 10px;
    max-width: 10px;
    min-height: 10px;
    max-height: 10px;
}

QLabel#connectionText {
    color: #167345;
    font-size: 13px;
    font-weight: 600;
}

/* 카메라 카드 */
QFrame#cameraCard {
    background-color: #FFFFFF;
    border: 1px solid #E1E7F0;
    border-radius: 18px;
}

QLabel#cameraTitleLabel {
    color: #1B2437;
    font-size: 18px;
    font-weight: 700;
}

QLabel#cameraDescriptionLabel {
    color: #8A94A8;
    font-size: 12px;
}

QFrame#streamBadge {
    background-color: #FFF1F0;
    border: 1px solid #FFD1CD;
    border-radius: 13px;
}

QLabel#streamDot {
    background-color: #E64940;
    border-radius: 4px;
    min-width: 8px;
    max-width: 8px;
    min-height: 8px;
    max-height: 8px;
}

QLabel#streamStatusLabel {
    color: #C63B34;
    font-size: 12px;
    font-weight: 700;
}

QFrame#cameraViewport {
    background-color: #111827;
    border: 1px solid #263247;
    border-radius: 14px;
}

QLabel#cameraViewLabel {
    background-color: transparent;
    border: none;
    color: #D8DFEA;
    font-size: 20px;
    font-weight: 600;
}

QLabel#cameraHintLabel {
    color: #8792A7;
    font-size: 12px;
}

QLabel#cameraSourceLabel {
    color: #7A8497;
    font-size: 12px;
}

/* 로봇 상태 정보 */
QFrame#robotStatusPanel {
    background-color: transparent;
    border: none;
}

QLabel#statusPanelTitleLabel {
    color: #1B2437;
    font-size: 17px;
    font-weight: 700;
}

QLabel#statusPanelDescriptionLabel {
    color: #8A94A8;
    font-size: 12px;
}

QFrame#speedStatusCard,
QFrame#robotConnectionStatusCard,
QFrame#destinationStatusCard {
    background-color: #FFFFFF;
    border: 1px solid #DCE5F1;
    border-radius: 15px;
}

QFrame#robotConnectionStatusCard {
    background-color: #F4FBF7;
    border-color: #CFE9DA;
}

QFrame#destinationStatusCard {
    background-color: #F4F8FF;
    border-color: #D4E2FA;
}

QLabel#speedTitleLabel,
QLabel#robotConnectionTitleLabel,
QLabel#destinationTitleLabel {
    color: #737E92;
    font-size: 15px;
    font-weight: 700;
}

QLabel#speedValueLabel,
QLabel#robotConnectionValueLabel,
QLabel#destinationValueLabel {
    color: #1C2940;
    font-size: 17px;
    font-weight: 700;
}

QLabel#destinationTitleLabel,
QLabel#destinationValueLabel {
    color: #245EC7;
    font-size: 17px;
}

QLabel#robotConnectionValueLabel {
    color: #247A5B;
}

/* 하단 기능 버튼 */
QPushButton {
    border-radius: 14px;
    min-height: 88px;
    padding: 10px 22px;
    font-size: 19px;
    font-weight: 700;
}

QPushButton#manualMoveButton {
    color: #245EC7;
    background-color: #FFFFFF;
    border: 2px solid #AFC9F8;
}

QPushButton#manualMoveButton:hover {
    background-color: #EEF5FF;
    border-color: #5B8FEA;
}

QPushButton#manualMoveButton:pressed {
    background-color: #DCEAFF;
}

QPushButton#manualMoveButton:checked {
    color: #FFFFFF;
    background-color: #3478E5;
    border-color: #3478E5;
}

QPushButton#manualMoveButton:checked:hover {
    background-color: #2868CC;
    border-color: #2868CC;
}

QPushButton#logViewButton {
    color: #216A66;
    background-color: #FFFFFF;
    border: 2px solid #A7DCD8;
}

QPushButton#logViewButton:hover {
    background-color: #ECFAF8;
    border-color: #55B7AF;
}

QPushButton#logViewButton:pressed {
    background-color: #D7F2EF;
}

QLabel#manualCaptionLabel,
QLabel#logCaptionLabel {
    color: #8892A5;
    font-size: 12px;
}</string>
